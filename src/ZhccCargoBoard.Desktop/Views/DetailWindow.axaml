<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZhccCargoBoard.Desktop.Views.DetailWindow"
        Title="航班详情"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Noto Sans CJK SC, Source Han Sans SC, Microsoft YaHei, sans-serif"
        FontSize="13">

  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="#6B7785" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="TextBlock.v">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="18,14">
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding FlightInfo}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#6B7785" />
      </StackPanel>
      <TextBlock Text="{Binding RouteText}" Foreground="#6B7785" Margin="0,4,0,0" />
      <Border Height="1" Background="#EFF3F5" Margin="0,10" />
    </StackPanel>

    <Button DockPanel.Dock="Bottom" Content="关闭" HorizontalAlignment="Right" Width="80"
            Margin="0,10,0,0" Click="OnCloseClick" Classes="ghost" />

    <ScrollViewer>
      <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Text="航班日期" Classes="k" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExecDate}" Classes="v" />

        <TextBlock Grid.Row="1" Text="计划起飞" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScheDep}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="2" Text="实际起飞" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActlDep}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="3" Text="计划降落" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ScheArr}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="4" Text="实际降落" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActlArr}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="5" Text="机型 / 机号" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="5" Grid.Column="1" Classes="v" Margin="0,8,0,0">
          <Run Text="{Binding CraftType}" /><Run Text=" · " /><Run Text="{Binding CraftNo}" />
        </TextBlock>

        <TextBlock Grid.Row="6" Text="代理" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Agency}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="7" Text="进出港" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DirectionText}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="8" Text="机位" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Stand}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="9" Text="航站楼" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding TerminalText}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="10" Text="航线" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding RouteAndStations}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="11" Text="航班任务" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding FlightTaskCn}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="12" Text="异常" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding AbnormalStateCn}" Classes="v" Margin="0,8,0,0" />

        <TextBlock Grid.Row="13" Text="首次记录" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="13" Grid.Column="1" Classes="v" Margin="0,8,0,0"
                   Text="{Binding FirstSeenLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />

        <TextBlock Grid.Row="14" Text="最近更新" Classes="k" Margin="0,8,10,0" />
        <TextBlock Grid.Row="14" Grid.Column="1" Classes="v" Margin="0,8,0,0"
                   Text="{Binding LastSeenLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
