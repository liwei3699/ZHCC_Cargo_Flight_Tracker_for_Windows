<Window x:Class="ZhccCargoBoard.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="486" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <StackPanel Margin="22,18,22,16">

        <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="更改后立即生效，并保存在本机。" Style="{StaticResource Caption}" Margin="0,4,0,0" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="自动刷新间隔（分钟）" VerticalAlignment="Center" />
            <ComboBox x:Name="RefreshBox" Grid.Column="1" Style="{StaticResource InputCombo}" IsEditable="True" />
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="本地数据保留（天）" VerticalAlignment="Center" />
            <ComboBox x:Name="RetentionBox" Grid.Column="1" Style="{StaticResource InputCombo}" IsEditable="True" />
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="导出时的日期格式" VerticalAlignment="Center" />
            <ComboBox x:Name="DateFormatBox" Grid.Column="1" Style="{StaticResource InputCombo}" />
        </Grid>

        <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,16,0,12" />

        <CheckBox x:Name="CloseToTrayBox" Margin="0,2"
                  Content="关闭主窗口时最小化到系统托盘（后台继续刷新）" />
        <CheckBox x:Name="StartMinimizedBox" Margin="0,10,0,2"
                  Content="启动后直接最小化到托盘" />

        <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,16,0,12" />

        <TextBlock Text="数据位置（本地数据库与日志）" Style="{StaticResource Caption}" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DataPathBox" Style="{StaticResource InputBox}" IsReadOnly="True" />
            <Button Grid.Column="1" Content="打开" Style="{StaticResource SecondaryButton}" Width="64" Margin="8,0,0,0" Click="OpenDataFolder_Click" />
        </Grid>

        <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Text="数据来源：郑州机场货运网 https://www.zzcargo.com/airline/1 · 版本 1.0.0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="80" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
