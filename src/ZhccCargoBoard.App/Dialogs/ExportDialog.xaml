<Window x:Class="ZhccCargoBoard.App.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出 Excel"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <StackPanel Margin="22,18,22,16">

        <TextBlock Text="导出航班数据" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="前 9 列与 example.xlsx 对齐（列名、顺序、时间与日期格式），附加列可按需勾选。"
                   Style="{StaticResource Caption}" Margin="0,4,0,0" />

        <TextBlock Text="导出范围" FontWeight="SemiBold" Margin="0,16,0,6" />
        <RadioButton x:Name="ScopeFiltered" GroupName="scope" IsChecked="True" Margin="0,3"
                     Checked="Scope_Changed" Content="当前筛选结果" />
        <RadioButton x:Name="ScopeAll" GroupName="scope" Margin="0,3"
                     Checked="Scope_Changed" Content="全部本地记录" />
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <RadioButton x:Name="ScopeRange" GroupName="scope" VerticalAlignment="Center"
                         Checked="Scope_Changed" Content="指定航班日期" />
            <DatePicker x:Name="RangeFrom" Width="122" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            <DatePicker x:Name="RangeTo" Width="122" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="CountText" Style="{StaticResource Caption}" Margin="0,6,0,0" />

        <TextBlock Text="附加信息列" FontWeight="SemiBold" Margin="0,16,0,6" />
        <WrapPanel x:Name="ExtrasPanel" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="全选" Style="{StaticResource GhostButton}" Height="26" Click="SelectAllExtras_Click" />
            <Button Content="全不选" Style="{StaticResource GhostButton}" Height="26" Click="ClearExtras_Click" />
        </StackPanel>

        <TextBlock Text="保存位置" FontWeight="SemiBold" Margin="0,16,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Style="{StaticResource InputBox}" />
            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <Grid Margin="0,20,0,0">
            <TextBlock Text="时间列写为 Excel 时间，日期列写为 Excel 日期，可在 Excel 中直接排序筛选。"
                       Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="300"
                       TextWrapping="Wrap" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="开始导出" Style="{StaticResource PrimaryButton}" Width="96" Click="Export_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
