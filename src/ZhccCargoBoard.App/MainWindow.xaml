<Window x:Class="ZhccCargoBoard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZhccCargoBoard.App"
        mc:Ignorable="d"
        Title="货机航班动态 · 郑州新郑国际机场"
        Width="1360" Height="860" MinWidth="1080" MinHeight="640"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style x:Key="FilterItem" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="1,0,0,4" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource GridText}" />

        <Style x:Key="CellTextLeft" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="10,0,6,0" />
        </Style>

        <Style x:Key="CellTextStrong" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题与操作 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="✈" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="货机航班动态" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="郑州新郑国际机场 · 数据来源 zzcargo.com · " Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding AutoRefreshText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastRefreshText}" FontSize="12.5" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding NextRefreshText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="立即刷新" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"
                            IsEnabled="{Binding IsNotBusy}" Margin="0,0,8,0" />
                    <Button Content="导出 Excel" Style="{StaticResource SecondaryButton}" Click="Export_Click" Margin="0,0,8,0" />
                    <Button Content="设置" Style="{StaticResource GhostButton}" Click="Settings_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选区 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Margin="20,14,20,0" Padding="14,12,14,4">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Style="{StaticResource FilterItem}" Width="118">
                    <TextBlock Text="航班号" Style="{StaticResource FilterLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding FlightNo, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="104">
                    <TextBlock Text="始发站" Style="{StaticResource FilterLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Origin, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="104">
                    <TextBlock Text="目的站" Style="{StaticResource FilterLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Dest, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="126">
                    <TextBlock Text="代理" Style="{StaticResource FilterLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding AgentOptions}"
                              SelectedItem="{Binding Agent, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="96">
                    <TextBlock Text="进出港" Style="{StaticResource FilterLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding DirectionOptions}"
                              SelectedItem="{Binding Direction, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="252">
                    <TextBlock Text="航班日期（起 / 止）" Style="{StaticResource FilterLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" Style="{StaticResource DateBox}" SelectedDate="{Binding DateFrom, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="–" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker Grid.Column="2" Style="{StaticResource DateBox}" SelectedDate="{Binding DateTo, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="110">
                    <TextBlock Text="航班状态" Style="{StaticResource FilterLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding Status, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="158">
                    <TextBlock Text="计划起飞时段（时:分）" Style="{StaticResource FilterLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource InputBox}" Text="{Binding TimeFrom, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="例如 08:00" />
                        <TextBlock Grid.Column="1" Text="–" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Text="{Binding TimeTo, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="例如 18:00" />
                    </Grid>
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="104">
                    <TextBlock Text="机型" Style="{StaticResource FilterLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding CraftTypeOptions}"
                              SelectedItem="{Binding CraftType, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="96">
                    <TextBlock Text="航司" Style="{StaticResource FilterLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding AirlineOptions}"
                              SelectedItem="{Binding Airline, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="104">
                    <TextBlock Text="机号" Style="{StaticResource FilterLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding CraftNo, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="例如 B1400" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" Width="208">
                    <TextBlock Text="关键字（航班 / 航线 / 机号 / 机位）" Style="{StaticResource FilterLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FilterItem}" VerticalAlignment="Bottom" Width="84">
                    <TextBlock Text=" " Style="{StaticResource FilterLabel}" />
                    <Button Content="重置筛选" Style="{StaticResource GhostButton}" Height="30" Click="Reset_Click" />
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- 错误提示 -->
        <Border Grid.Row="2" Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Margin="20,10,20,0"
                Padding="12,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{StaticResource DangerBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 统计与提示 -->
        <Grid Grid.Row="3" Margin="22,10,22,6">
            <TextBlock Text="{Binding CountText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="点击列头排序 · 选中一行查看详情" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
        </Grid>

        <!-- 表格与详情抽屉 -->
        <Grid Grid.Row="4">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="20,0,20,0" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="FlightGrid" Style="{StaticResource MainGrid}"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedFlight, Mode=TwoWay}"
                              Sorting="Grid_Sorting">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="航班信息" Binding="{Binding FlightInfo}"
                                                SortMemberPath="flight_info" Width="104"
                                                ElementStyle="{StaticResource CellTextStrong}" />

                            <DataGridTextColumn Header="起降机场" Binding="{Binding RouteAndStations}"
                                                SortMemberPath="route" Width="*" MinWidth="140"
                                                ElementStyle="{StaticResource CellTextLeft}" />

                            <DataGridTextColumn Header="计划起飞" Binding="{Binding ScheDep, Converter={StaticResource EmptyToDash}}"
                                                SortMemberPath="sche_dep" Width="92"
                                                ElementStyle="{StaticResource CellText}" />

                            <DataGridTextColumn Header="实际起飞" Binding="{Binding ActlDep, Converter={StaticResource EmptyToDash}}"
                                                SortMemberPath="actl_dep" Width="92"
                                                ElementStyle="{StaticResource CellText}" />

                            <DataGridTextColumn Header="计划降落" Binding="{Binding ScheArr, Converter={StaticResource EmptyToDash}}"
                                                SortMemberPath="sche_arr" Width="92"
                                                ElementStyle="{StaticResource CellText}" />

                            <DataGridTextColumn Header="实际降落" Binding="{Binding ActlArr, Converter={StaticResource EmptyToDash}}"
                                                SortMemberPath="actl_arr" Width="92"
                                                ElementStyle="{StaticResource CellText}" />

                            <DataGridTextColumn Header="航班日期" Binding="{Binding ExecDate}"
                                                SortMemberPath="exec_date" Width="100"
                                                ElementStyle="{StaticResource CellText}" />

                            <DataGridTemplateColumn Header="航班状态" SortMemberPath="status" Width="98">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                     Fill="{Binding StatusText, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="机型" Binding="{Binding CraftType}"
                                                SortMemberPath="craft_type" Width="84"
                                                ElementStyle="{StaticResource CellText}" />

                            <DataGridTextColumn Header="机号" Binding="{Binding CraftNo}"
                                                SortMemberPath="craft_no" Width="86"
                                                ElementStyle="{StaticResource CellText}" />

                            <DataGridTextColumn Header="代理" Binding="{Binding Agency}"
                                                SortMemberPath="agency" Width="80"
                                                ElementStyle="{StaticResource CellText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✈" FontSize="34" Foreground="#CBD7DC" HorizontalAlignment="Center" />
                        <TextBlock Text="暂无航班数据" FontSize="15" Margin="0,12,0,4" HorizontalAlignment="Center" />
                        <TextBlock Text="点击“立即刷新”从郑州机场货运网抓取最新动态" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        <Button Content="立即刷新" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Center" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 详情抽屉 -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="366" Margin="0,0,20,0"
                    Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Visibility="{Binding SelectedFlight, Converter={StaticResource NullToCollapsed}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.16" Color="#20303A" />
                </Border.Effect>
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedFlight.FlightInfo}" FontSize="19" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="10,3,0,0">
                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                                             Fill="{Binding SelectedFlight.StatusText, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding SelectedFlight.StatusText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedFlight.RouteText}" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Width="30" Height="30"
                                VerticalAlignment="Top" Click="CloseDetail_Click" ToolTip="关闭详情" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel>

                            <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,4,0,8" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="航班日期" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.ExecDate}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="计划起飞" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.ScheDep, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="实际起飞" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.ActlDep, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="计划降落" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.ScheArr, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="实际降落" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.ActlArr, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,6,0,8" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="机型 / 机号" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.CraftType}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="代理" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.Agency, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="进出港" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.DirectionText}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="机位" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.Stand, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="航站楼" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.Terminal, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="航班任务" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.FlightTaskCn, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="异常信息" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedFlight.AbnormalStateCn, Converter={StaticResource EmptyToDash}}" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,6,0,8" />

                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedFlight.LastSeenLocal, StringFormat='最近更新 {0:yyyy-MM-dd HH:mm}'}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding SelectedFlight.FirstSeenLocal, StringFormat='首次记录 {0:yyyy-MM-dd HH:mm}'}" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Height="32" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="90" Height="3" IsIndeterminate="True" BorderThickness="0"
                                 Foreground="{StaticResource AccentBrush}" Background="Transparent"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <TextBlock Text="数据仅供参考，以机场实际运行为准" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
